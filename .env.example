DATABASE_URL="postgresql://blog:blog_password@localhost:5432/nuxt_blog?schema=public"
NUXT_SESSION_PASSWORD="replace-with-at-least-32-characters-secret"
ADMIN_USERNAME="admin"
# 执行 seed 前设置至少 12 位的独立管理员密码。
ADMIN_PASSWORD=""
UPLOAD_DIR="./uploads"
KNOWLEDGE_FILE_DIR="./data/knowledge-files"
KNOWLEDGE_WORKER_ENABLED="true"
KNOWLEDGE_WORKER_POLL_INTERVAL_MS="2000"
KNOWLEDGE_WORKER_HEARTBEAT_INTERVAL_MS="15000"
KNOWLEDGE_WORKER_LEASE_TIMEOUT_MS="60000"
# 评论写入的允许来源 origin，逗号分隔。留空时只用 SITE_URL。
NUXT_COMMENT_ALLOWED_ORIGINS=""
# 评论限流桶 key 的 HMAC 密钥。留空时退回 NUXT_SESSION_PASSWORD。
NUXT_COMMENT_RATE_SECRET=""
SITE_URL="http://localhost:3000"
SITE_NAME="Jiupan Blog"

# 可信直连代理的 IP/CIDR；留空时仅使用 socket IP。Docker 需填写反代实际来源地址。
NUXT_COMMENT_TRUSTED_PROXIES=
