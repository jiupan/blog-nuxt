generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  username                 String                    @unique
  email                    String?                   @unique
  passwordHash             String
  role                     Role                      @default(USER)
  status                   UserStatus                @default(ACTIVE)
  lastLoginAt              DateTime?
  aiUsageLogs              AiUsageLog[]
  ragQueryLogs             RagQueryLog[]
  articleChatConversations ArticleChatConversation[]
  operatedAuditLogs        AdminAuditLog[]           @relation("AuditOperator")
  targetAuditLogs          AdminAuditLog[]           @relation("AuditTarget")
  resumes                  Resume[]
  agentApiKeys             AgentApiKey[]
  comments                 Comment[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model Resume {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  content   Json
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  operatorId   Int?
  targetUserId Int?
  // 评论审核目标。刻意不建外键：评论会随文章硬删除被级联清理，审计记录必须比目标活得久。
  commentId    Int?
  postId       Int?
  action       String
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  operator     User?    @relation("AuditOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([operatorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([commentId, createdAt])
  @@index([postId, createdAt])
  @@index([action, createdAt])
}

model Post {
  id                       Int                       @id @default(autoincrement())
  title                    String
  slug                     String                    @unique
  summary                  String?
  content                  String
  cover                    String?
  status                   PostStatus                @default(DRAFT)
  viewCount                Int                       @default(0)
  categoryId               Int?
  category                 Category?                 @relation(fields: [categoryId], references: [id])
  tags                     PostTag[]
  seoTitle                 String?
  seoDescription           String?
  isPinned                 Boolean                   @default(false)
  pinnedAt                 DateTime?
  relations                PostRelation[]            @relation("PostRelations")
  relatedBy                PostRelation[]            @relation("RelatedPostRelations")
  chunks                   PostChunk[]
  knowledgeDocument        KnowledgeDocument?
  knowledgeSyncJobs        KnowledgeSyncJob[]
  articleChatConversations ArticleChatConversation[]
  comments                 Comment[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  publishedAt              DateTime?
  agentPublication         AgentPublication?

  @@index([slug])
  @@index([status])
  @@index([isPinned, pinnedAt])
  @@index([publishedAt])
  @@index([categoryId])
}

model AgentApiKey {
  id             Int                @id @default(autoincrement())
  name           String
  tokenHash      String             @unique
  encryptedToken String?
  prefix         String
  createdById    Int?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime           @default(now())
  createdBy      User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publications   AgentPublication[]

  @@index([createdAt])
}

model AgentPublication {
  id              Int                    @id @default(autoincrement())
  keyId           Int
  requestId       String
  payloadHash     String
  title           String
  requestedStatus PostStatus
  sources         Json
  status          AgentPublicationStatus @default(PENDING)
  error           String?
  postId          Int?                   @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  key             AgentApiKey            @relation(fields: [keyId], references: [id], onDelete: Restrict)
  post            Post?                  @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([keyId, requestId])
  @@index([createdAt, id])
}

enum AgentPublicationStatus {
  PENDING
  SUCCESS
  FAILED
}

model ArticleChatConversation {
  id               Int                  @id @default(autoincrement())
  postId           Int
  userId           Int?
  anonymousKeyHash String?
  status           ArticleChatStatus    @default(ACTIVE)
  lastMessageAt    DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  post             Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  user             User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         ArticleChatMessage[]

  @@index([postId, userId, lastMessageAt])
  @@index([postId, anonymousKeyHash, lastMessageAt])
}

model ArticleChatMessage {
  id             Int                      @id @default(autoincrement())
  conversationId Int
  role           ArticleChatRole
  content        String
  status         ArticleChatMessageStatus @default(COMPLETED)
  citations      Json?
  durationMs     Int?
  error          String?
  createdAt      DateTime                 @default(now())
  conversation   ArticleChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// 原生评论。楼中楼只保留一层展示：threadRootId 指向主评论，replyToId 指向被回复的那一条。
model Comment {
  id                 Int                @id @default(autoincrement())
  postId             Int
  threadRootId       Int?
  replyToId          Int?
  /// ACCOUNT / GUEST / LEGACY。登录用户选择访客身份时仍记为 GUEST，不关联账户。
  authorKind         CommentAuthorKind
  authorUserId       Int?
  /// 只存访客凭证的摘要，不存明文。
  guestTokenHash     String?
  /// 展示名快照，账号改名或评论删除后仍然保留。
  authorName         String
  body               String
  bodyFormat         CommentBodyFormat @default(MARKDOWN)
  status             CommentStatus     @default(PENDING)
  /// 仅导入记录有值，与 legacyId 组成联合唯一键。
  legacySource       String?
  legacyId           String?
  /// 原生写入的幂等标识，与 requestFingerprint 组成快照摘要。
  requestId          String?
  requestFingerprint String?
  /// null 表示历史点赞数未知，0 表示确认没有点赞。导入时缺失字段不能补成 0。
  legacyLikeCount    Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  threadRoot Comment?  @relation("CommentThreadRoot", fields: [threadRootId], references: [id], onDelete: NoAction)
  replies    Comment[] @relation("CommentThreadRoot")
  replyTo    Comment?  @relation("CommentReplyTo", fields: [replyToId], references: [id], onDelete: NoAction)
  repliedBy  Comment[] @relation("CommentReplyTo")

  @@unique([postId, requestId])
  @@unique([legacySource, legacyId])
  @@index([postId, status, createdAt, id])
  @@index([postId, threadRootId, status, createdAt, id])
  @@index([threadRootId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@index([authorUserId, status, createdAt])
}

/// 固定窗口限流桶。计数在数据库内用 ON CONFLICT 条件更新封顶，重启和多副本都不会绕过。
model CommentRateBucket {
  id          Int                  @id @default(autoincrement())
  scope       CommentRateScope
  /// 账号 id、访客凭证摘要或 IP 的 HMAC，原始值不落库。
  keyHash     String
  windowKind  CommentRateWindow
  windowStart DateTime
  count       Int                  @default(0)
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([scope, keyHash, windowStart, windowKind])
  @@index([expiresAt])
}

model Category {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  icon       String?
  sort       Int      @default(0)
  isFeatured Boolean  @default(false)
  posts      Post[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sort, id])
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  sort      Int       @default(0)
  posts     PostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sort, id])
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model PostRelation {
  id            Int                @id @default(autoincrement())
  postId        Int
  relatedPostId Int
  reason        String?
  type          PostRelationType
  source        PostRelationSource @default(AI)
  sort          Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  post          Post               @relation("PostRelations", fields: [postId], references: [id], onDelete: Cascade)
  relatedPost   Post               @relation("RelatedPostRelations", fields: [relatedPostId], references: [id], onDelete: Cascade)

  @@unique([postId, relatedPostId])
  @@index([postId, sort])
  @@index([relatedPostId])
}

model PostChunk {
  id             Int                          @id @default(autoincrement())
  postId         Int
  chunkIndex     Int
  title          String
  slug           String
  summary        String?
  content        String
  headingPath    String?
  contentHash    String
  tokenCount     Int                          @default(0)
  categoryId     Int?
  tagIds         String                       @default("[]")
  embeddingModel String
  embeddingDim   Int
  embedding      Unsupported("vector(1536)")?
  status         PostChunkStatus              @default(ACTIVE)
  indexedAt      DateTime                     @default(now())
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  post           Post                         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, chunkIndex])
  @@index([postId])
  @@index([categoryId])
  @@index([contentHash])
  @@index([embeddingModel])
  @@index([status])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Menu {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  description String?
  location    MenuLocation @default(CUSTOM)
  isActive    Boolean      @default(true)
  items       MenuItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([location])
  @@index([isActive])
}

model MenuItem {
  id          Int          @id @default(autoincrement())
  menuId      Int
  parentId    Int?
  title       String
  url         String?
  type        MenuItemType @default(CUSTOM)
  targetId    Int?
  targetSlug  String?
  targetBlank Boolean      @default(false)
  badge       String?
  icon        String?
  sort        Int          @default(0)
  isVisible   Boolean      @default(true)
  menu        Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent      MenuItem?    @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[]   @relation("MenuItemTree")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([menuId, sort])
  @@index([parentId])
  @@index([type, targetId])
}

model AiUsageLog {
  id        Int           @id @default(autoincrement())
  userId    Int
  feature   String
  status    AiUsageStatus
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([ip, createdAt])
}

model KnowledgeDocument {
  id             Int                     @id @default(autoincrement())
  postId         Int                     @unique
  enabled        Boolean                 @default(true)
  status         KnowledgeDocumentStatus @default(PENDING)
  sourceHash     String
  indexedHash    String?
  chunkCount     Int                     @default(0)
  tokenCount     Int                     @default(0)
  embeddingModel String?
  embeddingDim   Int?
  lastIndexedAt  DateTime?
  lastError      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  post           Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([enabled, status])
  @@index([lastIndexedAt])
}

model KnowledgeSyncJob {
  id              Int                    @id @default(autoincrement())
  type            KnowledgeSyncJobType
  status          KnowledgeSyncJobStatus @default(PENDING)
  postId          Int?
  knowledgeFileId Int?
  totalItems      Int                    @default(0)
  completedItems  Int                    @default(0)
  successItems    Int                    @default(0)
  failedItems     Int                    @default(0)
  attempts        Int                    @default(0)
  maxAttempts     Int                    @default(3)
  error           String?
  activeKey       String?                @unique
  nextRunAt       DateTime               @default(now())
  lockedAt        DateTime?
  heartbeatAt     DateTime?
  lockedBy        String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  post            Post?                  @relation(fields: [postId], references: [id], onDelete: SetNull)
  knowledgeFile   KnowledgeFile?         @relation(fields: [knowledgeFileId], references: [id], onDelete: SetNull)

  @@index([status, nextRunAt, createdAt])
  @@index([status, heartbeatAt])
  @@index([postId, createdAt])
  @@index([knowledgeFileId, createdAt])
}

model KnowledgeFile {
  id             Int                     @id @default(autoincrement())
  name           String
  originalName   String
  storedName     String                  @unique
  mimeType       String
  extension      String
  size           Int
  fileHash       String
  enabled        Boolean                 @default(true)
  status         KnowledgeDocumentStatus @default(PENDING)
  chunkCount     Int                     @default(0)
  tokenCount     Int                     @default(0)
  embeddingModel String?
  embeddingDim   Int?
  lastIndexedAt  DateTime?
  lastError      String?
  chunks         KnowledgeFileChunk[]
  syncJobs       KnowledgeSyncJob[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([enabled, status])
  @@index([fileHash])
  @@index([createdAt])
}

model KnowledgeFileChunk {
  id              Int                          @id @default(autoincrement())
  knowledgeFileId Int
  chunkIndex      Int
  title           String
  content         String
  headingPath     String?
  pageNumber      Int?
  contentHash     String
  tokenCount      Int                          @default(0)
  embeddingModel  String
  embeddingDim    Int
  embedding       Unsupported("vector(1536)")?
  status          PostChunkStatus              @default(ACTIVE)
  indexedAt       DateTime                     @default(now())
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  knowledgeFile   KnowledgeFile                @relation(fields: [knowledgeFileId], references: [id], onDelete: Cascade)

  @@unique([knowledgeFileId, chunkIndex])
  @@index([knowledgeFileId])
  @@index([contentHash])
  @@index([embeddingModel])
  @@index([status])
}

model RagQueryLog {
  id                Int            @id @default(autoincrement())
  userId            Int?
  question          String
  rewrittenQuestion String?
  answer            String?
  status            RagQueryStatus
  retrievedChunks   Json?
  citations         Json?
  retrievalMs       Int?
  modelMs           Int?
  durationMs        Int?
  inputTokens       Int?
  outputTokens      Int?
  feedback          Int?
  error             String?
  createdAt         DateTime       @default(now())
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostChunkStatus {
  ACTIVE
  STALE
}

enum PostRelationType {
  PREREQUISITE
  EXTENSION
  SAME_TOPIC
  PRACTICE
  BACKGROUND
}

enum PostRelationSource {
  AI
  MANUAL
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AiUsageStatus {
  SUCCESS
  FAILED
  BLOCKED
}

enum KnowledgeDocumentStatus {
  PENDING
  SYNCING
  SYNCED
  STALE
  FAILED
  DISABLED
}

enum KnowledgeSyncJobType {
  SINGLE_POST
  BATCH_SYNC
  FULL_REBUILD
  REMOVE_STALE
  FILE_SYNC
}

enum KnowledgeSyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_FAILED
  FAILED
}

enum RagQueryStatus {
  SUCCESS
  NO_KNOWLEDGE
  FAILED
}

enum ArticleChatStatus {
  ACTIVE
  ARCHIVED
}

enum ArticleChatRole {
  USER
  ASSISTANT
}

enum ArticleChatMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MenuLocation {
  PRIMARY
  FOOTER
  MOBILE
  CUSTOM
}

enum MenuItemType {
  CUSTOM
  POST
  CATEGORY
  TAG
  PAGE
  ARCHIVE
  HOME
}

enum CommentAuthorKind {
  ACCOUNT
  GUEST
  LEGACY
}

enum CommentStatus {
  PENDING
  VISIBLE
  HIDDEN
  DELETED
}

enum CommentBodyFormat {
  MARKDOWN
  LEGACY_HTML
}

enum CommentRateScope {
  ACCOUNT
  GUEST
  IP
}

enum CommentRateWindow {
  MINUTE
  TEN_MINUTES
  HOUR
}
